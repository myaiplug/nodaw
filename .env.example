# ── Clerk (production OAuth + email) ─────────────────────────────
# Create app at https://dashboard.clerk.com → API Keys
# Enable Google / GitHub / email magic links as needed.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Server-only (Vercel / api stubs) — never expose to Vite client:
CLERK_SECRET_KEY=sk_test_...

# ── Profile / export sync API (optional; IndexedDB works offline) ─
# Point at Vercel deployment hosting /api/* from this repo:
VITE_NODAW_API_BASE=https://your-nodaw-api.vercel.app

# ── Marketplace (Stripe Connect) — feature flagged ───────────────
VITE_MARKETPLACE_ENABLED=false
VITE_MARKETPLACE_FEE_BPS=1000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only:
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Application fee uses VITE_MARKETPLACE_FEE_BPS (1000 = 10%)

# Optional Gemini (existing)
# GEMINI_API_KEY=
